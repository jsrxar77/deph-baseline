node_modules/
.DS_Store

# Rendered audio — large, and fully regenerable from the .strudel source via
# node tools/sounds/render.mjs (see docs/sync-pipeline.md). Not worth tracking in git.
media/*/sync/*.wav

# User-supplied source recordings for audio-first pieces (media/<name>/sync/source.mp3): someone else's music (e.g. a
# client's), so never tracked in this public repository without an explicit decision.
media/*/sync/source.*
tools/visuals/public/*.wav

.remotion/

# Rendered videos and stills
media/*/renders/

# Copies of the sync data that Remotion reads from public/ (the originals in media/<name>/sync/ are tracked).
tools/visuals/public/*-frames.json
tools/visuals/public/*-analysis.json

# DAW bridge (docs/daw-bridge.md): audio rendered for or exported from Ableton is regenerable and large. The .mid files,
# tracks.json and the Live Set (.als) are tracked; stems, exports, recordings and Ableton's backups are not.
media/*/daw/**/*.wav
media/*/daw/**/*.aif
media/*/daw/**/*.aiff
media/*/daw/**/Backup/
media/*/ableton/**/*.wav
media/*/ableton/**/*.aif
media/*/ableton/**/*.aiff
media/*/ableton/**/Backup/
# Ableton's per-file analysis data (next to any audio it has seen) and macOS folder-icon files.
*.asd
Icon?

