// "gnosis-live" — Gnosis for Strudel alone (no MIDI, no Ableton). gnosis.strudel in this folder is the separate,
// Ableton-oriented source and is untouched. Earlier drafts, kept in sounds/backup/: a cinematic one
// (strings/choir/violin/heartbeat — melodrama), a spectral one (two beating clusters, no motif — too simple, "una
// repetición constante"), and one that transposed/mirrored a single phrase — recognisable, but "2 patrones" doing
// the same thing in different registers, not real counterpoint: "no genera tensión, no genera espera". This
// version is a real fugue: a fixed subject, an independent countersubject, modulating entries, episodes built from
// the subject's own material, and stretto (overlapping imitation) driving the climax — not more voices doing the
// same thing, four voices doing genuinely different things at once.
//
// THE STORY
// The Demiurge (matter: low, dark, heavy) and Sophia (the spark: a bell-like FM voice, rising) are two independent
// musical lines, not one mirrored. She states a subject, alone, in the Pleroma. In the Descent he answers — the
// same subject, transposed, in his own low register — while she takes up a genuinely different countersubject, not
// his reflection. The talk deepens: the subject re-enters at new pitches as the chords darken, a second and third
// voice (Canon A, Canon B) begin imitating the subject close behind the others — stretto, voices chasing each
// other — until matter is at its heaviest. Then, with no jump, the Demiurge dissolves mid-stretto while Sophia's
// own register lifts an octave and the remaining voices draw tighter together: the chord opens wide, the arpeggio
// soars, the filter brightens. She wins. What follows is not a triumph but peace: one last fragment of the
// subject, alone, fading to nothing at 12:00.
//
// MATERIAL
// - The subject (SUBJ): D . F A C A F D — fixed, recurring, never regenerated. The answer (ANSWER) is the same
//   subject a fifth up, the real tonal-fugue convention. The countersubject (CSUBJ) is independent material (not a
//   mirror of the subject) with complementary rhythm: it moves while the subject holds, and holds while the
//   subject moves — that's what makes it counterpoint rather than doubling.
// - Episodes: short fragments of the subject's own first three notes, sequenced up or down through a passage
//   between entries — development built from the theme itself, keeping the piece travelling instead of just
//   alternating two fixed templates.
// - Sophia carries the throughline (subject, answer at modulating degrees, countersubject, episodes). The Demiurge
//   states his own countersubject and sometimes the answer, in his own register — never her notes mirrored. Canon A
//   (Density onward) and Canon B (from the Density/Transcendence hinge) imitate the subject/answer close behind in
//   time — stretto, real overlapping imitation, not parallel octave-doubling. Tintinnabuli (Pärt): the D minor
//   triad tone above whatever Sophia is singing.
// - Harmony: a seeded walk over D dorian chords free of internal semitones (Dm7 Dm6 Em7 F6 G69 Am7 C6), one every 2
//   cycles, 180 chords, never repeating; dark chords weigh most in Density, bright ones (G69, C6, F6) in
//   Transcendence. The pad's voicing anchor drifts through a short cycle of D-dorian tones instead of sitting on
//   one fixed note, so its top line actually goes somewhere. A second, higher voicing opens wide in Transcendence.
// - Flow: a continuous arpeggio of each chord's own tones (the "flying" voice), sparse in the Pleroma, dense in
//   Transcendence, thinning to almost nothing in peace. The walking bass picks a different figure per chord (root,
//   fifth, third-ish, at different positions) instead of looping one fixed rhythm cell for an entire movement.
// - A4 = 432 Hz everywhere. Binaural theta, a constant 6 Hz around D4 — deph's standing mark for this piece — from
//   the first second. D dorian throughout.
//
// DYNAMICS: every level is a continuous ramp across tens of cycles (`env`); nothing steps at a section boundary.
//
// CHAPTERS (30 cpm, 1 cycle = 2 s) — 360 cycles = 12:00 exact, same proportions as the 24:00 Ableton source, halved.
//   I   Pleroma          0 -  60   0:00 - 2:00    phrase, pad, bass, arpeggio, binaural from 0:00; tintinnabuli 0:16; his answer 0:24
//   II  Descent         60 - 135   2:00 - 4:30    the dialogue deepens; he grows; the canon's first voice readies
//   III Density        135 - 225   4:30 - 7:30    dark chords, two-voice canon, Demiurge at his loudest
//   IV  Transcendence  225 - 300   7:30 - 10:00   the canon converges; he fades; she rises an octave; the chord opens
//   V   Eternal peace  300 - 360  10:00 - 12:00   slow phrases, consonance only, everything ebbs to silence at 12:00

setcpm(30) // 1 cycle = 2 s. 360 cycles = 12:00 exact.

// ---- key and tuning (D dorian, A4 = 432 Hz) -----------------------------------------------------------------------
const ROOT = 'D';
const KEY_SUFFIX = ':dorian';
const scaleAt = (octave) => ROOT + octave + KEY_SUFFIX; // scaleAt(4) => "D4:dorian"
const A4 = 432;
const TUNE = 12 * Math.log2(A4 / 440);
const midiOf = (v) => (typeof v === 'string' ? noteToMidi(v) : v); // scale() yields note names
const tune = (p) => p.withValue((v) => ({ ...v, note: midiOf(v.note) + TUNE }));
const hz = (midi) => A4 * Math.pow(2, (midi - 69) / 12);

// ---- continuous levels: piecewise-linear ramps over the whole piece ---------------------------------------------
// env([[cycle, value], ...]) starts at cycle 0 and ends at 360. Segment ends match, so nothing steps.
const env = (pts) =>
  arrange(...pts.slice(1).map(([c, v], i) => [c - pts[i][0], saw.slow(c - pts[i][0]).range(pts[i][1], v)]));
const lerpAt = (c, pts) => {
  for (let i = 1; i < pts.length; i++) {
    if (c <= pts[i][0]) { const [c0, v0] = pts[i - 1], [c1, v1] = pts[i]; return v0 + ((v1 - v0) * (c - c0)) / (c1 - c0); }
  }
  return pts[pts.length - 1][1];
};

// ---- seeded randomness (the same piece every time) ---------------------------------------------------------------
const seeded = (seed) => () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

// ---- the harmonic walk: one chord per 2 cycles, 180 chords -------------------------------------------------------
// `tones` are the chord's own degrees from D (the arpeggio plays them); `sym` is for Strudel's voicing engine.
// Every chord is free of internal semitones (no maj7 or 9th rubbing), so the arpeggio and the voices never grind.
const CH = {
  Dm7: { sym: 'Dm7', deg: 0, tones: [0, 2, 4, 6] },
  Dm6: { sym: 'Dm6', deg: 0, tones: [0, 2, 4, 5] }, // the dorian chord: B natural
  Em7: { sym: 'Em7', deg: 1, tones: [1, 3, 5, 7] },
  F6: { sym: 'F6', deg: 2, tones: [2, 4, 6, 7] },
  G69: { sym: 'G69', deg: 3, tones: [3, 5, 7, 8, 11] },
  Am7: { sym: 'Am7', deg: 4, tones: [4, 6, 8, 10] },
  C6: { sym: 'C6', deg: 6, tones: [6, 8, 10, 11] },
};
const MOODS = [
  [60, { Dm7: 3, G69: 2, Am7: 2, C6: 2, Dm6: 1 }],
  [135, { Dm7: 2, G69: 2, Am7: 2, Em7: 1, F6: 1, C6: 2, Dm6: 1 }],
  [225, { Dm7: 3, Dm6: 2, Em7: 3, Am7: 3, F6: 2, G69: 1 }],
  [300, { G69: 4, C6: 3, F6: 3, Am7: 1, Dm7: 1 }],
  [360, { Dm7: 3, G69: 2, Dm6: 2, Am7: 1 }],
];
const chordRng = seeded(432);
const pickChord = (weights, prev) => {
  const entries = Object.entries(weights).filter(([k]) => k !== prev);
  let r = chordRng() * entries.reduce((s, [, w]) => s + w, 0);
  for (const [k, w] of entries) { r -= w; if (r <= 0) return k; }
  return entries[entries.length - 1][0];
};
const PROG = [];
let prevChord = null;
for (let i = 0; i < 180; i++) {
  const mood = MOODS.find(([end]) => i * 2 < end)[1];
  const key = i === 0 || i === 179 ? 'Dm7' : i === 178 ? 'G69' : pickChord(mood, prevChord);
  PROG.push(CH[key]);
  prevChord = key;
}
const CHORDS = cat(...PROG.map((c) => pure(c.sym))).slow(2);
const ROOT_DEGREES = cat(...PROG.map((c) => pure(c.deg))).slow(2);
// The voicing engine picks the inversion closest to `anchor` — a single fixed anchor for the whole piece keeps the
// top note almost in place the entire time (smooth, but static: reported as "siempre lo mismo"). Drifting the
// anchor through a short cycle of D-dorian tones gives the pad's top line somewhere to actually go.
const ANCHOR_LOW = cat(...PROG.map((c, i) => pure(['A3', 'C4', 'B3', 'D4', 'C4', 'B3'][i % 6]))).slow(2);
const ANCHOR_HIGH = cat(...PROG.map((c, i) => pure(['D5', 'F5', 'E5', 'G5', 'F5', 'E5'][i % 6]))).slow(2);
const voiced = (anchor) => chord(CHORDS).dict('ireal').anchor(anchor).mode('below').voicing();
const chordAt = (cyc) => PROG[Math.min(179, Math.floor(cyc / 2))];

// ---- the fugue: a real subject, an independent countersubject, modulating entries, episodes, stretto --------------
// Earlier drafts always transposed or inverted the SAME line — recognisable transformation is not development, and
// a "mirror" voice is not counterpoint (it's the same notes). Real fix: a fixed, recurring SUBJECT (not regenerated
// each time — a theme the ear can actually learn) answered by an independent COUNTERSUBJECT with complementary
// rhythm (moves while the subject holds, holds while the subject moves) in the Demiurge's own register. The subject
// re-enters at different scale degrees as the piece goes on (modulating entries, real fugal technique), canonA and
// canonB later imitate it at a short time offset (stretto — overlapping entries, the actual source of the tension
// and density the piece was missing, not just more voices doing the same thing). Short fragments of the subject's
// own first three notes get sequenced through episodes between entries, so the piece keeps travelling instead of
// alternating between two fixed templates.
const SUBJ = [0, null, 2, 4, 6, 4, 2, 0];                  // D . F A C A F D — the subject
const SUBJ_W = [2, 1, 2, 2, 3, 2, 2, 4];
const ANSWER = SUBJ.map((d) => (d === null ? null : d + 4)); // the subject a fifth up — the tonal answer
const CSUBJ = [null, null, null, null, 5, 4, 3, 2, 1, 0];  // independent: fills in while the subject holds its peak
const CSUBJ_W = [2, 2, 2, 2, 1, 1, 1, 1, 1, 4];
const num = (a, f) => a.map((d) => (d === null ? null : f(d)));
const triadAbove = (d) => { let x = d + 1; while (![0, 2, 4].includes(((x % 7) + 7) % 7)) x++; return x; };
const dur = (a, w) => a.map((d, i) => (d === null ? '~' : d) + '@' + w[i]).join(' ');

// A fragment: the subject's own first three pitched notes (D F A), sequenced up or down through `reps` statements —
// real "episode" technique (development built from the theme's own material, not new unrelated material).
const fragment = (dir, reps) => {
  const notes = [], weights = [];
  for (let r = 0; r < reps; r++) { const b = dir * r; notes.push(b, b + 2, b + 4); weights.push(1, 1, 2); }
  notes.push(null); weights.push(2);
  return { notes, weights };
};
const materialFor = (b) => {
  let notes, weights;
  if (b.role === 'subj') { notes = SUBJ; weights = SUBJ_W; }
  else if (b.role === 'answer') { notes = ANSWER; weights = SUBJ_W; }
  else if (b.role === 'csubj') { notes = CSUBJ; weights = CSUBJ_W; }
  else { const f = fragment(b.dir, b.reps); notes = f.notes; weights = f.weights; }
  return { notes: notes.map((d) => (d === null ? null : d + (b.deg || 0))), weights };
};
// Builds one voice's whole 360-cycle pattern from a list of blocks (role + register, or silence) — every block's
// `len` sums to the piece's total, so there's no manual cycle bookkeeping to get wrong.
const buildLine = (blocks, useTint) => {
  const segs = blocks.map((b) => {
    if (!b.role) return [b.len, silence];
    const { notes, weights } = materialFor(b);
    const final = useTint ? num(notes, triadAbove) : notes;
    return [b.len, n(mini(dur(final, weights))).scale(scaleAt(b.oct)).slow(b.len)];
  });
  return arrange(...segs);
};

// Sophia — states the subject and answer at modulating degrees, carries the countersubject when the Demiurge takes
// the subject, and threads episodes between entries. Always active: she's the piece's own throughline.
const SOPHIA_BLOCKS = [
  // I. Pleroma — exposition, alone.
  { len: 14, role: 'subj', deg: 0, oct: 4 }, { len: 10, role: 'frag', dir: 1, reps: 3, deg: 4, oct: 4 },
  { len: 14, role: 'subj', deg: 0, oct: 4 }, { len: 12, role: 'frag', dir: -1, reps: 3, deg: 2, oct: 4 },
  { len: 10, role: 'csubj', deg: 7, oct: 4 },
  // II. Descent — the Demiurge answers; she takes the countersubject, then a modulating entry a step up.
  { len: 16, role: 'csubj', deg: 4, oct: 4 }, { len: 12, role: 'frag', dir: 1, reps: 3, deg: 6, oct: 4 },
  { len: 16, role: 'subj', deg: 2, oct: 4 }, { len: 15, role: 'frag', dir: 1, reps: 4, deg: 4, oct: 4 },
  { len: 16, role: 'csubj', deg: 7, oct: 4 },
  // III. Density — canonA joins (stretto begins); the heaviest, most contrapuntally dense movement.
  { len: 16, role: 'answer', deg: 0, oct: 5 }, { len: 12, role: 'frag', dir: 1, reps: 3, deg: 0, oct: 4 },
  { len: 16, role: 'csubj', deg: 7, oct: 4 }, { len: 14, role: 'subj', deg: 2, oct: 4 },
  { len: 12, role: 'frag', dir: -1, reps: 3, deg: 4, oct: 4 }, { len: 20, role: 'csubj', deg: 4, oct: 4 },
  // IV. Transcendence — her own register lifts to the octave above; canonB joins the stretto.
  { len: 10, role: 'subj', deg: 0, oct: 5 }, { len: 14, role: 'answer', deg: 0, oct: 5 },
  { len: 16, role: 'csubj', deg: 4, oct: 5 }, { len: 16, role: 'subj', deg: 0, oct: 5 },
  { len: 19, role: 'csubj', deg: 7, oct: 5 },
  // V. Eternal peace — one last fragment, spacious, then true silence before 12:00.
  { len: 25, role: 'frag', dir: 0, reps: 1, deg: 0, oct: 4 }, { len: 35 },
];
// The Demiurge — an independent countersubject voice (not a mirror of Sophia), absent until matter manifests in
// Descent, states the answer himself twice (he gets to carry the subject too, low), and fades out mid-Transcendence.
const DEMIURGE_BLOCKS = [
  { len: 60 }, // I. Pleroma — matter hasn't manifested yet
  { len: 16, role: 'answer', deg: 0, oct: 2 }, { len: 12, role: 'frag', dir: -1, reps: 3, deg: 0, oct: 2 },
  { len: 16, role: 'csubj', deg: 6, oct: 2 }, { len: 15, role: 'frag', dir: 1, reps: 3, deg: 2, oct: 2 },
  { len: 16, role: 'answer', deg: 3, oct: 2 },
  { len: 16, role: 'csubj', deg: 0, oct: 2 }, { len: 12, role: 'frag', dir: -1, reps: 3, deg: 4, oct: 2 },
  { len: 16, role: 'answer', deg: 3, oct: 2 }, { len: 14, role: 'csubj', deg: 2, oct: 2 },
  { len: 12, role: 'frag', dir: 1, reps: 3, deg: 0, oct: 2 }, { len: 20, role: 'answer', deg: 0, oct: 2 },
  { len: 10, role: 'csubj', deg: 0, oct: 2 }, { len: 14, role: 'answer', deg: 0, oct: 2 }, { len: 51 }, // fades, dissolved
  { len: 60 }, // V. gone
];
// Canon A — imitates the subject in stretto (close time-offset via .late below), Density onward only.
const CANONA_BLOCKS = [
  { len: 60 }, { len: 75 },
  { len: 16, role: 'subj', deg: 0, oct: 3 }, { len: 12, role: 'frag', dir: -1, reps: 3, deg: 4, oct: 3 },
  { len: 16, role: 'answer', deg: 0, oct: 3 }, { len: 14, role: 'subj', deg: 3, oct: 3 },
  { len: 12, role: 'frag', dir: 1, reps: 3, deg: 0, oct: 3 }, { len: 20, role: 'answer', deg: 3, oct: 3 },
  { len: 10, role: 'subj', deg: 0, oct: 3 }, { len: 14, role: 'answer', deg: 0, oct: 3 }, { len: 51 },
  { len: 60 },
];
// Canon B — joins right at the Density/Transcendence hinge, the highest stretto voice, then recedes.
const CANONB_BLOCKS = [
  { len: 60 }, { len: 75 },
  { len: 70 }, { len: 20, role: 'subj', deg: 4, oct: 5 },
  { len: 14, role: 'answer', deg: 4, oct: 5 }, { len: 16, role: 'csubj', deg: 0, oct: 5 },
  { len: 16, role: 'subj', deg: 4, oct: 5 }, { len: 29 },
  { len: 60 },
];
// Sophia, doubled an octave higher — only in Transcendence, for brightness/shimmer at the climax. An honest
// doubling of her own material (not a claim of independent voice), the same orchestration trick as padHigh.
const SOPHIA_UP_BLOCKS = [
  { len: 60 }, { len: 75 }, { len: 90 },
  { len: 10, role: 'subj', deg: 0, oct: 6 }, { len: 14, role: 'answer', deg: 0, oct: 6 },
  { len: 16, role: 'csubj', deg: 4, oct: 6 }, { len: 16, role: 'subj', deg: 0, oct: 6 },
  { len: 19, role: 'csubj', deg: 7, oct: 6 },
  { len: 60 },
];
// Humanize: a small random onset offset (0-30 ms at this tempo) so notes stop landing exactly on the grid — the
// same technique the-field.strudel uses on its arpeggio. A plain continuous `rand` sampled at each note's own
// onset (not `rand.segment(N)`, which profiled ~25x more expensive for the same perceptual effect — see CLAUDE.md).
const humanize = (p) => p.late(rand.range(0, 0.015));

// ---- the flowing arpeggio: each chord's own tones, a contour that wanders up and down the chord ladder -------------
const DENS = [[0, 0.45], [60, 0.6], [135, 0.75], [225, 0.85], [260, 0.92], [300, 0.6], [345, 0.25], [360, 0.1]];
const LO = [[0, 2], [225, 3], [270, 5], [300, 5], [345, 1], [360, 0]];
const HI = [[0, 9], [135, 10], [225, 11], [270, 14], [300, 14], [345, 9], [360, 8]];
const arpRng = seeded(99);
let ladderPos = 3;
let ladderDir = 1;
const arpSlot = (c, i) => {
  const pcs = new Set(c.tones.map((d) => d % 7));
  const toks = [];
  for (let s = 0; s < 32; s++) {
    const cyc = i * 2 + s / 16;
    const lo = Math.round(lerpAt(cyc, LO)), hi = Math.round(lerpAt(cyc, HI));
    const ladder = [];
    for (let d = lo; d <= hi; d++) if (pcs.has(((d % 7) + 7) % 7)) ladder.push(d);
    const accent = s % 4 === 0 ? 0.25 : s % 2 === 0 ? 0 : -0.2;
    if (arpRng() > Math.min(0.97, Math.max(0.03, lerpAt(cyc, DENS) + accent))) { toks.push('~'); continue; }
    ladderPos = Math.min(ladderPos, ladder.length - 1);
    if (ladderPos <= 0) ladderDir = 1;
    else if (ladderPos >= ladder.length - 1) ladderDir = -1;
    else if (arpRng() < 0.12) ladderDir = -ladderDir;
    ladderPos = Math.max(0, Math.min(ladder.length - 1, ladderPos + ladderDir * (arpRng() < 0.75 ? 1 : 2)));
    toks.push(ladder[ladderPos]);
  }
  return toks.join(' ');
};

// ---- the walking bass: a different figure per chord, not one formula repeated for the whole movement --------------
const SECTION_OF = (cycle) => [60, 135, 225, 300, 360].findIndex((end) => cycle < end);
// Each section has a few candidate figures (root/fifth/third-ish, at different positions in the 8-step chord
// window); which one plays is chosen per chord, so the bass itself keeps developing instead of looping the same
// rhythm cell 15-30 times in a row — the "se repite y se repite" the accompaniment was reported to do.
const BASS_FIGS = [
  (r, r2, r3, nx) => [r, '~', '~', '~', '~', '~', '~', '~'],
  (r, r2, r3, nx) => [r, '~', r2, '~', '~', '~', '~', '~'],
  (r, r2, r3, nx) => [r, '~', '~', '~', r2, '~', '~', '~'],
  (r, r2, r3, nx) => [r, '~', r3, '~', '~', r2, '~', '~'],
  (r, r2, r3, nx) => [r, '~', '~', r2, '~', '~', r3, '~'],
  (r, r2, r3, nx) => [r, '~', r2, '~', r3, '~', nx, '~'],
];
// Which figures are even eligible, per section — Pleroma stays mostly spare (figures 0-2), Density can use all of
// them, Peace settles back to almost nothing.
const BASS_POOL = [[0, 1, 2], [0, 1, 2, 3], [1, 2, 3, 4, 5], [2, 3, 4], [0, 0, 1]];
const bassRng = seeded(777);
const bassSlot = (c, i) => {
  const sec = SECTION_OF(i * 2);
  const pool = BASS_POOL[sec];
  const pick = BASS_FIGS[pool[Math.floor(bassRng() * pool.length)]];
  const next = PROG[Math.min(i + 1, 179)].deg;
  const r = c.deg;
  return pick(r, r + 4, r + 2, next).join(' ');
};

// ---- voices ---------------------------------------------------------------------------------------------------------

// Pad: the harmonic walk on two sawtooth layers 7 cents apart, panned apart (from The Field) — one clean pad, no
// vowel formant, no ensemble wall.
const pad = (notes, g, cutoff) =>
  stack(tune(notes).add(note(0.07)).pan(0.3), tune(notes).add(note(-0.07)).pan(0.7))
    .s("sawtooth")
    .attack(2.5).decay(2).sustain(0.7).release(4)
    .lpf(cutoff)
    .gain(g)
    .room(0.7).size(8).orbit(1);

// Glass (Sophia): two harmonic FM operators (ratios 2 and 3: no non-scale partials), long non-metric echo — one
// consistent timbre for every register and role she takes (lead, octave-up, canon), not a choir of different voices.
const glass = (p, g, cutoff) =>
  stack(tune(p).fm(1).fmh(2).gain(g), tune(p).fm(0.5).fmh(3).gain(g).velocity(0.5))
    .s("sine")
    .attack(0.04).decay(1.2).sustain(0.25).release(4)
    .fmattack(0.012).fmdecay(0.4).fmsustain(0.08).fmenv('exp')
    .lpf(cutoff)
    .pan(sine.slow(10).range(0.35, 0.65))
    .delay(0.3).delaytime(1.13).delayfeedback(0.45)
    .room(0.85).size(9).orbit(2);

// Tintinnabuli: a soft triangle under Sophia.
const tint = (p, g) =>
  tune(p)
    .s("triangle")
    .attack(0.1).decay(2).sustain(0.3).release(4)
    .gain(g)
    .pan(sine.slow(10).range(0.65, 0.35))
    .room(0.85).size(9).orbit(2);

// Demiurge: dark and heavy, not vocal — filtered saw with a sub-octave layer, no vowel, no vibrato.
const demiurge = (p, g, cutoff) =>
  stack(tune(p).gain(g), tune(p).add(note(-12)).gain(g.mul(0.6)))
    .s("sawtooth")
    .attack(0.6).decay(3).sustain(0.55).release(5)
    .lpf(cutoff)
    .room(0.7).size(7).orbit(4);

// Arpeggio: a plucked harp-like voice (triangle), echo, ping-pong pan.
const arp = (p, g, cutoff) =>
  tune(p)
    .s("triangle")
    .attack(0.008).decay(0.9).sustain(0.1).release(2)
    .velocity(perlin.slow(6).range(0.55, 1))
    .lpf(cutoff)
    .gain(g)
    .pan(sine.slow(7).range(0.3, 0.7))
    .delay(0.35).delaytime(1.13).delayfeedback(0.45)
    .room(0.3).size(3).orbit(3);

// Bass: roots, walking figure; saw through a dark filter so its harmonics are audible on small speakers.
const bass = (p, g) =>
  tune(p)
    .s("sawtooth")
    .attack(0.05).decay(1.5).sustain(0.5).release(2)
    .lpf(260)
    .gain(g)
    .room(0.3).size(4).orbit(5);

// Sub: the chord roots, a floor that does not beat.
const sub = (g) =>
  tune(n(ROOT_DEGREES).scale(scaleAt(1)))
    .s("sine")
    .attack(2).decay(1).sustain(0.9).release(4)
    .lpf(220)
    .gain(g);

// Wind: pink noise in 2-cycle breaths, the filter swept by `cutoff`.
const wind = (g, cutoff) =>
  s("pink").slow(2)
    .attack(2).decay(1).sustain(1).release(4)
    .lpf(cutoff)
    .gain(g)
    .pan(sine.slow(9).range(0.25, 0.75))
    .room(0.7).size(8).orbit(1);

// Binaural: a sine hard-left and one hard-right around D4 (A4 = 432), a constant 6 Hz beat, dry, headphones only.
const CARRIER = hz(62);
const binaural = (g) =>
  stack(freq(CARRIER - 3).s("sine").pan(0), freq(CARRIER + 3).s("sine").pan(1))
    .slow(2)
    .attack(3).decay(1).sustain(1).release(5)
    .gain(g);

// ---- arrangement: one layer per voice; every level is an `env` ramp ---------------------------------------------

// Pad
pad: pad(
  voiced(ANCHOR_LOW),
  env([[0, 0.02], [12, 0.04], [60, 0.05], [135, 0.06], [225, 0.07], [249, 0.05], [270, 0.075], [300, 0.075], [330, 0.05], [360, 0]]).mul(0.7),
  env([[0, 700], [16, 1100], [60, 1300], [135, 1100], [225, 900], [250, 800], [280, 2400], [300, 2400], [360, 500]]),
)

// High pad: an octave and a half above, opening wide only in Transcendence — the chord, breaking open.
padHigh: pad(
  voiced(ANCHOR_HIGH),
  env([[0, 0], [150, 0], [225, 0.012], [270, 0.035], [300, 0.035], [345, 0.01], [360, 0]]).mul(0.7),
  env([[0, 1500], [225, 1800], [280, 3200], [360, 1200]]),
)

// Sub
sub: sub(env([[0, 0.04], [20, 0.12], [225, 0.15], [250, 0.10], [265, 0.16], [320, 0.14], [360, 0]]))

// Walking bass
bass: bass(
  arrange(...PROG.map((c, i) => [2, n(mini(bassSlot(c, i))).scale(scaleAt(1)).slow(2)])),
  env([[0, 0.025], [50, 0.05], [135, 0.07], [225, 0.08], [250, 0.05], [270, 0.07], [310, 0.06], [340, 0.02], [360, 0]]).mul(0.85),
)

// Sophia: subject, answer, countersubject and episodes — her own throughline, from the first second
sophia: glass(
  humanize(buildLine(SOPHIA_BLOCKS, false)),
  env([[0, 0.04], [15, 0.05], [225, 0.052], [250, 0.04], [270, 0.06], [300, 0.06], [345, 0.03], [360, 0]]).mul(2.3),
  env([[0, 2200], [225, 2400], [270, 3000], [360, 1600]]),
)

// Sophia doubled an octave up: pure brightness in Transcendence, not an independent voice
sophiaUp: glass(
  humanize(buildLine(SOPHIA_UP_BLOCKS, false)),
  env([[0, 0], [235, 0], [270, 0.025], [300, 0.028], [345, 0.01], [360, 0]]).mul(2.3),
  pure(2600),
)

// Canon A: imitates the subject/answer in stretto — close behind Sophia and the Demiurge, Density onward
canonA: glass(
  humanize(buildLine(CANONA_BLOCKS, false)),
  env([[0, 0], [150, 0], [165, 0.035], [215, 0.035], [228, 0.03], [250, 0.02], [300, 0], [360, 0]]).mul(2.0),
  pure(1900),
).late(4)

// Canon B: the highest stretto voice, joining right at the Density/Transcendence hinge, then receding
canonB: glass(
  humanize(buildLine(CANONB_BLOCKS, false)),
  env([[0, 0], [195, 0], [215, 0.022], [228, 0.032], [250, 0.022], [270, 0.01], [300, 0], [360, 0]]).mul(2.0),
  pure(2400),
).late(3)

// Tintinnabuli: the triad tone above whatever Sophia is singing, same register she's in
tint: tint(buildLine(SOPHIA_BLOCKS, true), env([[0, 0], [8, 0], [20, 0.028], [225, 0.032], [260, 0.025], [300, 0.02], [350, 0], [360, 0]]))

// The Demiurge: his own countersubject, not a mirror — absent until matter manifests, fades while she rises
demiurge: demiurge(
  humanize(buildLine(DEMIURGE_BLOCKS, false)),
  env([[0, 0], [60, 0], [90, 0.025], [135, 0.045], [210, 0.075], [228, 0.075], [270, 0], [360, 0]]).mul(2.3),
  env([[0, 520], [135, 720], [228, 910], [270, 450], [360, 390]]),
)

// The flowing arpeggio
arp: arp(
  arrange(...PROG.map((c, i) => [2, n(mini(arpSlot(c, i))).scale(scaleAt(3)).slow(2)])),
  env([[0, 0.03], [15, 0.04], [135, 0.055], [225, 0.06], [249, 0.03], [270, 0.055], [320, 0.04], [350, 0.015], [360, 0]]).mul(0.65),
  env([[0, 1800], [135, 2400], [225, 2000], [270, 3200], [360, 1400]]),
)

// Wind: a breath under the inhale and the rise
wind: wind(
  env([[0, 0], [220, 0], [250, 0.012], [280, 0.02], [310, 0.012], [350, 0], [360, 0]]),
  env([[0, 300], [225, 500], [280, 2600], [360, 400]]),
)

// Binaural theta, constant 6 Hz, from the first second
binaural: binaural(env([[0, 0.02], [6, 0.03], [300, 0.035], [360, 0]]))

// A touch quieter overall, per the user's ear — everything above is balanced against everything else;
// this just sets how loud the whole piece is.
all((x) => x.postgain(0.88))
