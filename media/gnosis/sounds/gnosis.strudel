  [50, tune(n("~ 2 ~ 4").scale(scaleAt(3)).slow(50).gain(0.028).attack(5.0).decay(3.0).sustain(0.65).release(10.0).cutoff(540).room(0.93).size(8).orbit(5).midichan(5))],
