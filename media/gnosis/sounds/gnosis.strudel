// "gnosis" — Generative ambient piece for deep meditation and trans-dimensional transport (>20 min)
// Concept: Cuerpo Material — ¿Prisión para el Alma o Varillas de Conexión a Tierra para Sophía?
// Reference: Agencia Cósmica
// Key: D:dorian calibrated to A4 = 432 Hz
// Duration: 21:20 exact (1280 seconds = 640 cycles at 30 cpm / 120 BPM in 4/4)
//
// 5-Phase Subtle Dynamic Arc (Homogeneous, gentle, continuous flow):
// I.   Pleroma (0:00 - 3:12 | 96 cycles): The Unmanifest Light, seed motif, Theta binaural (6 Hz)
// II.  Descent (3:12 - 7:28 | 128 cycles): Emanation of Sophia, cascading bell arpeggios, gentle breathing pads
// III. Density (7:28 - 12:48 | 160 cycles): The Material Crucible, deep pedal notes cross, intertwining lines
// IV.  Grounding (12:48 - 18:08 | 160 cycles): CLIMAX — The Earthing Rod connects, full 8-track harmonious integration
// V.   Transfiguration (18:08 - 21:20 | 96 cycles): Golden harmonics, peaceful resting on fundamental D

setcpm(30) // 1 cycle = 2 seconds. 640 cycles = 1280s = 21:20 exact.

// ---- Tuning & Scale Foundation (D Dorian @ 432 Hz) ----------------------------------------------
const ROOT = 'D';
const KEY_SUFFIX = ':dorian';
const KEY = ROOT + KEY_SUFFIX; // "D:dorian"
const scaleAt = (octave) => ROOT + octave + KEY_SUFFIX;

// A4 = 432 Hz calibration (deph standing standard: -31.77 cents offset)
const A4 = 432;
const TUNE = 12 * Math.log2(A4 / 440); // -0.317666 semitones
const tune = (p) => p.add(note(TUNE));

// ---- Ch 1: Primordial Drone / Continuous Harmonic Pedal (Surge XT: Basses / Eighties Drone) ----
// Sustained pedal notes on D2 and A2 with slow, gradual breathing and non-metric spatial delay
$: arrange(
  // I. Pleroma (96 c): Pedal fundamental D2 continuo y etéreo, emergiendo suavemente
  [96, tune(n("<0 ~ 0 ~>").scale(scaleAt(2)).slow(24).gain(0.08).attack(6.0).decay(4.0).sustain(0.85).release(12.0).cutoff(200).room(0.85).size(8).orbit(1).midichan(1))],
  // II. Descent (128 c): El pedal se expande alternando tónica D2 y quinta A2 en ciclos lentos de 20 ciclos
  [128, tune(n("<0 4 0 [0, 4]>").scale(scaleAt(2)).slow(20).gain(0.09).attack(5.0).decay(3.5).sustain(0.85).release(10.0).cutoff(240).room(0.85).size(8).delay(0.25).delaytime(1.33).delayfeedback(0.45).orbit(1).midichan(1))],
  // III. Density (160 c): Pedal armónico sostenido que cruza con el sub-bajo (Ch 2) sin colisionar
  [160, tune(n("<[0, 4] 0 [0, 6] 4>").scale(scaleAt(2)).slow(24).gain(0.10).attack(4.5).decay(3.0).sustain(0.85).release(10.0).cutoff(280).room(0.85).size(8).delay(0.3).delaytime(1.33).delayfeedback(0.5).orbit(1).midichan(1))],
  // IV. Grounding (160 c): Clímax de sustentación. El pedal envuelve toda la base con calidez dorada
  [160, tune(n("<[0, 4] [0, 6] [0, 4] 0>").scale(scaleAt(2)).slow(20).gain(0.11).attack(4.0).decay(3.0).sustain(0.9).release(10.0).cutoff(310).room(0.88).size(8).delay(0.3).delaytime(1.33).delayfeedback(0.5).orbit(1).midichan(1))],
  // V. Transfiguration (96 c): Retorno a la nota pedal pura D2, disolviéndose suavemente en el silencio
  [96, tune(n("<0 ~>").scale(scaleAt(2)).slow(24).gain(0.075).attack(6.0).decay(4.0).sustain(0.8).release(14.0).cutoff(190).room(0.9).size(8).orbit(1).midichan(1))]
)

// ---- Ch 2: Varilla de Anclaje / Grounding Sub-Bass (Surge XT: Basses / Sub 1) -------------------
// Sub-bajo puro en octava 1 (D1 = 36.7 Hz @ 432 Hz). Desplazamientos polimétricos cruzados con Ch 1
$: arrange(
  // I. Pleroma (96 c): Suspiro ultra-profundo espaciado en la fundamental D1
  [96, tune(n("0").scale(scaleAt(1)).slow(16).gain(0.08).attack(5.0).decay(3.0).sustain(0.8).release(10.0).cutoff(105).orbit(2).midichan(2))],
  // II. Descent (128 c): Movimiento lento en quinta (D1 - A1) desfasado a 16 ciclos
  [128, tune(n("<0 0 4 0>").scale(scaleAt(1)).slow(16).gain(0.095).attack(4.0).decay(3.0).sustain(0.8).release(8.0).cutoff(120).orbit(2).midichan(2))],
  // III. Density (160 c): Densidad material sutil. Notas pedal que sostienen los cambios armónicos
  [160, tune(n("<0 2 0 4 0 3 0 0>").scale(scaleAt(1)).slow(20).gain(0.11).attack(3.0).decay(2.5).sustain(0.8).release(6.0).cutoff(135).orbit(2).midichan(2))],
  // IV. Grounding (160 c): Firmeza y arraigo total sin estridencias ni saltos dinámicos
  [160, tune(n("<0 4 0 2 4 0 0 4>").scale(scaleAt(1)).slow(20).gain(0.12).attack(2.5).decay(2.0).sustain(0.85).release(6.0).cutoff(145).orbit(2).midichan(2))],
  // V. Transfiguration (96 c): Anclaje en reposo final sobre D1
  [96, tune(n("0").scale(scaleAt(1)).slow(16).gain(0.08).attack(5.0).decay(3.0).sustain(0.8).release(12.0).cutoff(100).orbit(2).midichan(2))]
)

// ---- Ch 3: Motivo de Sophía / Arp Bells (Serum 2: Bell / BL - Zenatrope 02) ---------------------
// FM Bell ratios enteros (fmh 2 y 3) para sonido puro y cálido. Frases que entran y salen flotando
const sophiaSeed = "0 2 4 6 7 6 4 2";
const sophiaWide = "0 4 7 9 11 9 7 4";
$: arrange(
  // I. Pleroma (96 c): Gancho inicial en 0:00, seguido de pausas orgánicas donde el motivo respira
  [96, tune(n("<[0 2 4 6 7 6 4 2] ~ [2 4 6 7 9 7 6 4] ~>").scale(scaleAt(4)).slow(20).fmi(0.35).fmh(2).attack(0.08).decay(1.2).sustain(0.3).release(6.0).gain(0.065).pan(sine.slow(14).range(0.25, 0.75)).room(0.88).size(8).delay(0.35).delaytime(1.23).delayfeedback(0.52).orbit(3).midichan(3))],
  // II. Descent (128 c): El motivo se expande en cascadas cruzadas con desfase polimétrico de 18 ciclos
  [128, tune(n("<[0 2 4 7] [9 7 4 2] ~ [4 7 9 11] [9 7 4 0] ~>").scale(scaleAt(4)).slow(18).fmi(0.45).fmh(2).attack(0.06).decay(1.0).sustain(0.35).release(5.5).gain(0.075).pan(cosine.slow(12).range(0.2, 0.8)).room(0.88).size(8).delay(0.4).delaytime(1.23).delayfeedback(0.55).orbit(3).midichan(3))],
  // III. Density (160 c): Diálogo entre la chispa de Sophía y las texturas subyacentes
  [160, tune(n("<[0 2 4 6 7 4] ~ [3 4 7 9 7 4] ~ [0 4 6 7 9 7]>").scale(scaleAt(4)).slow(20).fmi(0.5).fmh(3).attack(0.06).decay(0.9).sustain(0.35).release(5.0).gain(0.08).pan(sine.slow(10).range(0.15, 0.85)).room(0.88).size(8).delay(0.4).delaytime(1.17).delayfeedback(0.55).orbit(3).midichan(3))],
  // IV. Grounding (160 c): Clímax de luminosidad cristalina. Frases ondulantes de bells cruzando el espacio
  [160, tune(n("<[0 4 7 9 11 9 7 4] ~ [2 4 6 7 9 7 4 0] ~>").scale(scaleAt(4)).slow(16).fmi(0.55).fmh(2).attack(0.05).decay(0.9).sustain(0.4).release(5.5).gain(0.088).pan(sine.slow(8).range(0.1, 0.9)).room(0.9).size(8).delay(0.42).delaytime(1.17).delayfeedback(0.56).orbit(3).midichan(3))],
  // V. Transfiguration (96 c): Campanas distanciadas que descienden en cadencia tranquila hacia el silencio
  [96, tune(n("<[0 2 4 6 7 6 4 2] ~ ~ ~>").scale(scaleAt(4)).slow(24).fmi(0.3).fmh(2).attack(0.1).decay(1.4).sustain(0.25).release(8.0).gain(0.055).pan(0.5).room(0.9).size(8).orbit(3).midichan(3))]
)

// ---- Ch 4: Pleroma Pad (Serum 2: Pad / PD - Analog Soft Cotton) ----------------------------------
// Armonía modal suave y continua en acordes suspendidos de D dórico. Envolventes ultra-largas
$: arrange(
  // I. Pleroma (96 c): Atmósfera cálida y envolvente, sin aristas
  [96, tune(n("<[0, 2, 4, 6] [~] [4, 6, 8, 10] [~]>").scale(scaleAt(3)).slow(24).gain(0.10).attack(6.0).decay(3.0).sustain(0.8).release(10.0).cutoff(680).room(0.9).size(8).orbit(4).midichan(4))],
  // II. Descent (128 c): Movimiento armónico sutil desfasado en 28 ciclos, cruzando con el tintinnabuli
  [128, tune(n("<[0, 2, 4, 6] [2, 4, 6, 8] [4, 6, 8, 10] [0, 4, 6, 7]>").scale(scaleAt(3)).slow(28).gain(0.115).attack(5.0).decay(3.0).sustain(0.8).release(9.0).cutoff(sine.slow(40).range(700, 1050)).room(0.9).size(8).orbit(4).midichan(4))],
  // III. Density (160 c): Progresión armónica rica (Dm9 - Em7 - Fmaj7 - Gsus4) con modulación suave
  [160, tune(n("<[0, 2, 4, 7] [2, 4, 7, 9] [3, 5, 7, 10] [0, 3, 5, 7]>").scale(scaleAt(3)).slow(32).gain(0.125).attack(4.5).decay(2.5).sustain(0.85).release(8.5).cutoff(sine.slow(32).range(800, 1150)).room(0.9).size(8).orbit(4).midichan(4))],
  // IV. Grounding (160 c): Máxima plenitud y envolvente sedosa. Dinámica contenida y cálida
  [160, tune(n("<[0, 2, 4, 7] [4, 7, 9, 11] [2, 4, 7, 9] [0, 4, 7, 10]>").scale(scaleAt(3)).slow(28).gain(0.13).attack(4.0).decay(2.5).sustain(0.85).release(9.0).cutoff(sine.slow(24).range(850, 1250)).room(0.92).size(8).orbit(4).midichan(4))],
  // V. Transfiguration (96 c): Cierre suave hacia el acorde matriz, reposando en paz
  [96, tune(n("<[0, 2, 4, 6] [0, 4, 7, 9]>").scale(scaleAt(3)).slow(24).gain(0.09).attack(6.0).decay(3.0).sustain(0.75).release(12.0).cutoff(600).room(0.9).size(8).orbit(4).midichan(4))]
)

// ---- Ch 5: Tintinnabuli / Secondary Voice (Surge XT: Pads / Harmonic Sweep) ---------------------
// Caminos armónicos que entran y salen en contra-canto con el pad, tejiendo intervalos de 5ta, 6ta y 9na
$: arrange(
  // I. Pleroma (96 c): Suspensión armónica sutil en registro medio-agudo, entrando en el segundo tercio
  [96, tune(n("<~ [0, 4] ~ [4, 7]>").scale(scaleAt(4)).slow(24).gain(0.06).attack(6.0).decay(3.0).sustain(0.7).release(8.0).cutoff(720).room(0.88).size(8).orbit(5).midichan(5))],
  // II. Descent (128 c): Movimiento por pasos que cruza sobre el Pleroma Pad (polimetría de 20 ciclos)
  [128, tune(n("<[0, 4] ~ [2, 6] [4, 7] ~ [0, 7]>").scale(scaleAt(4)).slow(20).gain(0.075).attack(4.5).decay(2.5).sustain(0.75).release(7.5).cutoff(820).room(0.88).size(8).orbit(5).midichan(5))],
  // III. Density (160 c): Diálogo contrapuntístico suspendido, creando profundidad dimensional
  [160, tune(n("<~ [0, 3, 7] ~ [2, 5, 9] ~ [4, 7, 11] [0, 4, 7]>").scale(scaleAt(4)).slow(24).gain(0.085).attack(4.0).decay(2.0).sustain(0.75).release(7.0).cutoff(950).room(0.88).size(8).orbit(5).midichan(5))],
  // IV. Grounding (160 c): Resonancia plena entrelazada con el solo lead y el arpegio
  [160, tune(n("<[0, 4, 7] ~ [2, 6, 9] [4, 7, 11] ~ [0, 4, 7]>").scale(scaleAt(4)).slow(20).gain(0.095).attack(3.5).decay(2.0).sustain(0.8).release(7.5).cutoff(1050).room(0.9).size(8).orbit(5).midichan(5))],
  // V. Transfiguration (96 c): Disolución pacífica en quintas puras
  [96, tune(n("<[0, 4] ~ [0, 7] ~>").scale(scaleAt(4)).slow(24).gain(0.06).attack(6.0).decay(3.0).sustain(0.6).release(10.0).cutoff(680).room(0.9).size(8).orbit(5).midichan(5))]
)

// ---- Ch 6: Texturas Cósmicas / Astral Wind (Serum 2: Soundscape / SC - Astral Projection) --------
// Respiración cósmica continua con modulación espacial lenta (ciclos de 32 y 36)
$: arrange(
  // I. Pleroma (96 c): Siseo etéreo y viento dimensional levísimo
  [96, tune(n("<0 ~ 7 ~>").scale(scaleAt(6)).slow(32).gain(0.038).cutoff(1600).fmi(0.25).fmh(1.5).attack(8.0).decay(5.0).sustain(0.6).release(12.0).room(0.95).size(9).pan(sine.slow(20).range(0.2, 0.8)).orbit(6).midichan(6))],
  // II. Descent (128 c): Movimiento ondulatorio que acompaña el descenso con filtro orgánico lento
  [128, tune(n("<0 4 7 11>").scale(scaleAt(6)).slow(28).gain(0.048).cutoff(sine.slow(30).range(1100, 2200)).fmi(0.35).fmh(1.5).attack(6.0).decay(4.0).sustain(0.65).release(10.0).room(0.95).size(9).pan(cosine.slow(16).range(0.15, 0.85)).orbit(6).midichan(6))],
  // III. Density (160 c): Textura sutilmente más granular flotando sobre el tapiz
  [160, tune(n("<0 2 4 7 9 7>").scale(scaleAt(6)).slow(24).gain(0.058).cutoff(sine.slow(24).range(1200, 2600)).fmi(0.4).fmh(2.5).attack(5.0).decay(3.5).sustain(0.7).release(9.0).room(0.95).size(9).pan(sine.slow(14).range(0.1, 0.9)).orbit(6).midichan(6))],
  // IV. Grounding (160 c): Partículas etéreas entrelazadas en el espacio estéreo
  [160, tune(n("<0 4 7 11 9 7 4 0>").scale(scaleAt(6)).slow(24).gain(0.065).cutoff(sine.slow(20).range(1300, 2800)).fmi(0.45).fmh(2.5).attack(4.0).decay(3.0).sustain(0.7).release(8.0).room(0.95).size(9).pan(cosine.slow(12).range(0.05, 0.95)).orbit(6).midichan(6))],
  // V. Transfiguration (96 c): Susurro suave que se expande hacia el horizonte
  [96, tune(n("<0 ~ 7 ~>").scale(scaleAt(6)).slow(32).gain(0.035).cutoff(1300).fmi(0.2).fmh(1.5).attack(8.0).decay(5.0).sustain(0.5).release(14.0).room(0.95).size(9).pan(0.5).orbit(6).midichan(6))]
)

// ---- Ch 7: Capa Binaural Theta 6 Hz @ 432 Hz Calibration (Headphones Only) ---------------------
// Portadora D4 = 288.326 Hz en afinación A4 = 432 Hz. Beat de 6 Hz: Canal Izquierdo = 285.326 Hz, Derecho = 291.326 Hz.
// Sin reverb ni delay para preservar la separación 100% estereofónica binaural. Rango dinámico homogéneo.
const D4_HZ = 288.326; // Frecuencia exacta de D4 afinado a A4 = 432 Hz
const THETA_BEAT = 6.0; // 6 Hz = Onda Theta profunda para meditación consciente y trance lúcido
$: arrange(
  [96, stack(
    s("sine").freq(D4_HZ - THETA_BEAT / 2).pan(0).gain(0.038).attack(8.0).decay(3.0).sustain(1).release(10.0),
    s("sine").freq(D4_HZ + THETA_BEAT / 2).pan(1).gain(0.038).attack(8.0).decay(3.0).sustain(1).release(10.0)
  ).slow(96).orbit(7).midichan(7)],
  [128, stack(
    s("sine").freq(D4_HZ - THETA_BEAT / 2).pan(0).gain(0.042).attack(6.0).decay(3.0).sustain(1).release(8.0),
    s("sine").freq(D4_HZ + THETA_BEAT / 2).pan(1).gain(0.042).attack(6.0).decay(3.0).sustain(1).release(8.0)
  ).slow(128).orbit(7).midichan(7)],
  [160, stack(
    s("sine").freq(D4_HZ - THETA_BEAT / 2).pan(0).gain(0.045).attack(5.0).decay(3.0).sustain(1).release(8.0),
    s("sine").freq(D4_HZ + THETA_BEAT / 2).pan(1).gain(0.045).attack(5.0).decay(3.0).sustain(1).release(8.0)
  ).slow(160).orbit(7).midichan(7)],
  [160, stack(
    s("sine").freq(D4_HZ - THETA_BEAT / 2).pan(0).gain(0.048).attack(5.0).decay(3.0).sustain(1).release(8.0),
    s("sine").freq(D4_HZ + THETA_BEAT / 2).pan(1).gain(0.048).attack(5.0).decay(3.0).sustain(1).release(8.0)
  ).slow(160).orbit(7).midichan(7)],
  [96, stack(
    s("sine").freq(D4_HZ - THETA_BEAT / 2).pan(0).gain(0.036).attack(8.0).decay(3.0).sustain(1).release(12.0),
    s("sine").freq(D4_HZ + THETA_BEAT / 2).pan(1).gain(0.036).attack(8.0).decay(3.0).sustain(1).release(12.0)
  ).slow(96).orbit(7).midichan(7)]
)

// ---- Ch 8: Solo Lead / Voz de la Revelación (Serum 2: Lead / LD - Analog Glow) -------------------
// Melodía lírica suave y flotante que entra y sale en frases largas, cruzando los arpegios y pads
$: arrange(
  // I. Pleroma (96 c): Entrada sutilísima en la segunda mitad con una nota suspendida que susurra
  [96, tune(n("<~ ~ ~ 0>").scale(scaleAt(5)).slow(24).gain(0.05).attack(3.0).decay(2.0).sustain(0.6).release(6.0).cutoff(1100).room(0.9).size(8).delay(0.35).delaytime(1.33).delayfeedback(0.5).orbit(8).midichan(8))],
  // II. Descent (128 c): Primera respuesta melódica al motivo de Sophía en frases espaciadas de 20 ciclos
  [128, tune(n("<~ [7 6] ~ ~ [4 2] ~>").scale(scaleAt(5)).slow(20).gain(0.068).attack(2.0).decay(1.8).sustain(0.65).release(5.0).cutoff(1300).room(0.88).size(8).delay(0.35).delaytime(1.33).delayfeedback(0.52).orbit(8).midichan(8))],
  // III. Density (160 c): Frases líricas que tejen puentes armónicos entre las notas pedal y el arpegio
  [160, tune(n("<~ [0 2] ~ [4 7] ~ [9 7] ~ [4 2]>").scale(scaleAt(5)).slow(24).gain(0.082).attack(1.8).decay(1.5).sustain(0.7).release(5.0).cutoff(1500).room(0.88).size(8).delay(0.38).delaytime(1.23).delayfeedback(0.54).orbit(8).midichan(8))],
  // IV. Grounding (160 c): Canto meditativo integrador con amplio espacio y colas de delay
  [160, tune(n("<[0 4] ~ [7 9] ~ [11 9] ~ [7 4] ~>").scale(scaleAt(5)).slow(20).gain(0.095).attack(1.5).decay(1.2).sustain(0.75).release(5.5).cutoff(1700).room(0.9).size(8).delay(0.4).delaytime(1.23).delayfeedback(0.55).orbit(8).midichan(8))],
  // V. Transfiguration (96 c): La voz reposa en una nota pedal extendida que se funde en el Pleroma
)
