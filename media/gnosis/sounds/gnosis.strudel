  [60, tune(n("0").scale(scaleAt(1)).slow(60).gain(0.074).attack(10.0).sustain(1.0).release(24.0).cutoff(115).legato(1.2).midichan(2))],
  [50, tune(n("0").scale(scaleAt(1)).slow(50).gain(0.074).attack(10.0).sustain(1.0).release(24.0).cutoff(115).legato(1.2).midichan(2))],
  [50, tune(n("0").scale(scaleAt(1)).slow(50).gain(0.072).attack(10.0).sustain(1.0).release(24.0).cutoff(112).legato(1.2).midichan(2))],
  [50, tune(n("0").scale(scaleAt(1)).slow(50).gain(0.070).attack(10.0).sustain(1.0).release(24.0).cutoff(110).legato(1.2).midichan(2))],
  [40, tune(n("0").scale(scaleAt(1)).slow(40).gain(0.068).attack(10.0).sustain(1.0).release(28.0).cutoff(105).legato(1.2).midichan(2))],
  [40, tune(n("0").scale(scaleAt(1)).slow(40).gain(0.065).attack(12.0).sustain(1.0).release(32.0).cutoff(100).legato(1.2).midichan(2))],
  [40, tune(n("0").scale(scaleAt(1)).slow(40).gain(0.060).attack(12.0).sustain(1.0).release(36.0).cutoff(95).legato(1.2).midichan(2))]
)

// ---- Ch 3: Motivo de Sophía / Arp Bells (Serum 2: Bell / BL - Zenatrope 02) ---------------------
// La chispa divina. Registro medio cálido (D3–F4, NUNCA estridente).
// Evoluciona de una semilla solitaria de 1 nota hacia un contrapunto polifónico maduro.
$: arrange(
  // I. Pleroma (60 + 30 + 30 = 120 c)
  [60, silence],
  [30, tune(n("~ 0 ~ ~").scale(scaleAt(3)).slow(30).gain(0.035).attack(0.4).decay(3.0).sustain(0.2).release(12.0).cutoff(650).room(0.95).size(9).delay(0.35).delaytime(1.33).delayfeedback(0.5).orbit(3).midichan(3))],
  [30, tune(n("~ 4 ~ 0").scale(scaleAt(3)).slow(30).gain(0.036).attack(0.3).decay(2.5).sustain(0.25).release(11.0).cutoff(680).room(0.95).size(9).delay(0.35).delaytime(1.33).delayfeedback(0.5).orbit(3).midichan(3))],
  // II. Descent (50 + 50 + 50 = 150 c)
  [50, tune(n("~ [0 2 4] ~ ~").scale(scaleAt(3)).slow(50).gain(0.038).attack(0.25).decay(2.2).sustain(0.25).release(10.0).cutoff(700).room(0.94).size(8).delay(0.38).delaytime(1.23).delayfeedback(0.52).orbit(3).midichan(3))],
  [50, tune(n("~ ~ ~ [2 4 6]").scale(scaleAt(3)).slow(50).gain(0.038).attack(0.25).decay(2.2).sustain(0.25).release(10.0).cutoff(720).room(0.94).size(8).delay(0.38).delaytime(1.23).delayfeedback(0.52).orbit(3).midichan(3))],
  [50, tune(n("[0 4 2] ~ [4 6 7] ~").scale(scaleAt(3)).slow(50).gain(0.039).attack(0.2).decay(2.0).sustain(0.28).release(9.5).cutoff(740).room(0.93).size(8).delay(0.4).delaytime(1.17).delayfeedback(0.54).orbit(3).midichan(3))],
  // III. Density (60 + 60 + 60 = 180 c)
  [60, tune(n("[0 2 3 4] ~ ~ [4 3 2 0]").scale(scaleAt(3)).slow(60).gain(0.040).attack(0.18).decay(1.9).sustain(0.28).release(9.0).cutoff(750).room(0.92).size(8).delay(0.4).delaytime(1.17).delayfeedback(0.54).orbit(3).midichan(3))],
  [60, tune(n("~ [4 5 6 4] ~ [2 4 6 5]").scale(scaleAt(3)).slow(60).gain(0.041).attack(0.18).decay(1.8).sustain(0.3).release(9.0).cutoff(760).room(0.92).size(8).delay(0.4).delaytime(1.17).delayfeedback(0.54).orbit(3).midichan(3))],
  [60, tune(n("[0 3 4 6] ~ [6 5 4 2] ~").scale(scaleAt(3)).slow(60).gain(0.042).attack(0.15).decay(1.8).sustain(0.3).release(9.0).cutoff(780).room(0.92).size(8).delay(0.4).delaytime(1.17).delayfeedback(0.55).orbit(3).midichan(3))],
  // IV. Grounding (50 + 50 + 50 = 150 c)
  [50, tune(n("[0 4 7 6] ~ [4 6 7 9] ~").scale(scaleAt(3)).slow(50).gain(0.043).attack(0.15).decay(1.8).sustain(0.3).release(9.0).cutoff(780).room(0.92).size(8).delay(0.4).delaytime(1.17).delayfeedback(0.55).orbit(3).midichan(3))],
  [50, tune(n("[7 6 4 2] ~ ~ [4 2 0]").scale(scaleAt(3)).slow(50).gain(0.040).attack(0.2).decay(2.0).sustain(0.25).release(9.5).cutoff(750).room(0.93).size(8).delay(0.38).delaytime(1.23).delayfeedback(0.52).orbit(3).midichan(3))],
  [50, tune(n("[0, 4] ~ ~ [2, 6]").scale(scaleAt(3)).slow(50).gain(0.036).attack(0.25).decay(2.2).sustain(0.22).release(10.0).cutoff(700).room(0.94).size(8).delay(0.35).delaytime(1.33).delayfeedback(0.5).orbit(3).midichan(3))],
  // V. Transfiguration (40 + 40 + 40 = 120 c)
  [40, tune(n("~ 4 ~ ~").scale(scaleAt(3)).slow(40).gain(0.032).attack(0.3).decay(2.5).sustain(0.2).release(12.0).cutoff(650).room(0.95).size(9).orbit(3).midichan(3))],
  [40, tune(n("~ ~ 0 ~").scale(scaleAt(3)).slow(40).gain(0.028).attack(0.4).decay(3.0).sustain(0.15).release(14.0).cutoff(600).room(0.95).size(9).orbit(3).midichan(3))],
  [40, silence]
)

// ---- Ch 4: Pleroma Pad (Serum 2: Pad / PD - Analog Soft Cotton) ----------------------------------
// Manto armónico continuo que modula sus acordes lentamente en Re dórico (D1-D2).
// Crossfades largos y suaves (attack 14-16s, release 32-40s). Cero cortes abruptos.
$: arrange(
  // I. Pleroma (60 + 30 + 30 = 120 c)
  [60, silence],
  [30, silence],
  [30, tune(n("~ ~ [0, 4] [0, 4]").scale(scaleAt(1)).slow(30).gain(0.032).attack(16.0).sustain(1.0).release(32.0).cutoff(220).room(0.95).size(9).legato(1.2).orbit(4).midichan(4))],
  // II. Descent (50 + 50 + 50 = 150 c)
  [50, tune(n("[0, 4, 8]").scale(scaleAt(1)).slow(50).gain(0.036).attack(14.0).sustain(1.0).release(32.0).cutoff(240).room(0.95).size(9).legato(1.2).orbit(4).midichan(4))],
  [50, tune(n("[0, 2, 6]").scale(scaleAt(1)).slow(50).gain(0.038).attack(14.0).sustain(1.0).release(32.0).cutoff(250).room(0.95).size(9).legato(1.2).orbit(4).midichan(4))],
  [50, tune(n("[0, 4, 9]").scale(scaleAt(1)).slow(50).gain(0.040).attack(14.0).sustain(1.0).release(32.0).cutoff(260).room(0.95).size(9).legato(1.2).orbit(4).midichan(4))],
  // III. Density (60 + 60 + 60 = 180 c)
  [60, tune(n("[3, 7, 11]").scale(scaleAt(1)).slow(60).gain(0.041).attack(14.0).sustain(1.0).release(32.0).cutoff(270).room(0.95).size(9).legato(1.2).orbit(4).midichan(4))],
  [60, tune(n("[2, 6, 9]").scale(scaleAt(1)).slow(60).gain(0.042).attack(14.0).sustain(1.0).release(32.0).cutoff(280).room(0.95).size(9).legato(1.2).orbit(4).midichan(4))],
  [60, tune(n("[0, 4, 7, 10]").scale(scaleAt(1)).slow(60).gain(0.044).attack(14.0).sustain(1.0).release(32.0).cutoff(290).room(0.95).size(9).legato(1.2).orbit(4).midichan(4))],
  // IV. Grounding (50 + 50 + 50 = 150 c)
  [50, tune(n("[0, 4, 9, 13]").scale(scaleAt(1)).slow(50).gain(0.044).attack(12.0).sustain(1.0).release(32.0).cutoff(300).room(0.95).size(9).legato(1.2).orbit(4).midichan(4))],
  [50, tune(n("[0, 4, 7]").scale(scaleAt(1)).slow(50).gain(0.040).attack(14.0).sustain(1.0).release(32.0).cutoff(270).room(0.95).size(9).legato(1.2).orbit(4).midichan(4))],
  [50, tune(n("[0, 4]").scale(scaleAt(1)).slow(50).gain(0.038).attack(14.0).sustain(1.0).release(32.0).cutoff(250).room(0.95).size(9).legato(1.2).orbit(4).midichan(4))],
  // V. Transfiguration (40 + 40 + 40 = 120 c)
  [40, tune(n("[0, 4]").scale(scaleAt(1)).slow(40).gain(0.034).attack(16.0).sustain(1.0).release(36.0).cutoff(230).room(0.95).size(9).legato(1.2).orbit(4).midichan(4))],
  [40, tune(n("0").scale(scaleAt(1)).slow(40).gain(0.030).attack(16.0).sustain(1.0).release(40.0).cutoff(200).room(0.95).size(9).legato(1.2).orbit(4).midichan(4))],
  [40, silence]
)

// ---- Ch 5: Tintinnabuli / Contracanto Armónico (Surge XT: Pads / Harmonic Sweep) ------------------
// Gotas sutiles de luz en registro medio (D3–D4) que completan los diálogos de Ch 3 y Ch 8.
$: arrange(
  // I. Pleroma (60 + 30 + 30 = 120 c)
  [60, silence],
  [30, silence],
  [30, silence],
  // II. Descent (50 + 50 + 50 = 150 c)
  [50, silence],
