// ---- Ch 7: Capa Binaural Theta 6 Hz @ 432 Hz Calibration (Audio Stem) ----------------------------
// Frecuencia D4 = 288.326 Hz afinada a 432 Hz. Beat de 6 Hz: L = 285.326 Hz, R = 291.326 Hz.
// Stem de audio continuo y homogéneo de 24:00 (1440 s) sin saltos.
const D4_HZ = 288.326;
const THETA_BEAT = 6.0;
const thetaVoice = (d, g) => stack(
  s("sine").freq(D4_HZ - THETA_BEAT / 2).pan(0).gain(g).attack(8.0).sustain(1.0).release(12.0),
  s("sine").freq(D4_HZ + THETA_BEAT / 2).pan(1).gain(g).attack(8.0).sustain(1.0).release(12.0)
).slow(d).legato(1.2).orbit(7).midichan(7);

$: arrange(
  [60, thetaVoice(60, 0.035)],
  [30, thetaVoice(30, 0.035)],
  [30, thetaVoice(30, 0.035)],
  [50, thetaVoice(50, 0.036)],
  [50, thetaVoice(50, 0.036)],
  [50, thetaVoice(50, 0.036)],
  [60, thetaVoice(60, 0.036)],
  [60, thetaVoice(60, 0.036)],
  [60, thetaVoice(60, 0.036)],
  [50, thetaVoice(50, 0.036)],
  [50, thetaVoice(50, 0.036)],
  [50, thetaVoice(50, 0.034)],
  [40, thetaVoice(40, 0.032)],
  [40, thetaVoice(40, 0.028)],
  [40, thetaVoice(40, 0.020)]
)

// ---- Ch 8: Voz Cálida de la Revelación / Contrapunto Modal (Serum 2: Pad / LD - Analog Glow) ----
// Registro medio-cálido en D2–A2 (73–110 Hz). NUNCA agudo, NUNCA estridente.
// Canto meditativo lírico que dialoga con Ch 3 en llamada y respuesta. En Pleroma guarda silencio.
$: arrange(
  // I. Pleroma (60 + 30 + 30 = 120 c): Silencio contemplativo reverente
  [60, silence],
  [30, silence],
  [30, silence],
  // II. Descent (50 + 50 + 50 = 150 c): Despierta en la etapa 5 (min 5:40) con ataque suave de 10s
  [50, silence],
  [50, tune(n("~ ~ [0 2] ~").scale(scaleAt(2)).slow(50).gain(0.024).attack(10.0).decay(6.0).sustain(0.7).release(16.0).cutoff(420).room(0.95).size(9).legato(1.2).orbit(8).midichan(8))],
  [50, tune(n("~ [4 2] ~ [2 0]").scale(scaleAt(2)).slow(50).gain(0.026).attack(8.0).decay(6.0).sustain(0.75).release(16.0).cutoff(440).room(0.95).size(9).legato(1.2).orbit(8).midichan(8))],
  // III. Density (60 + 60 + 60 = 180 c): Diálogo canónico modal y variaciones en imitación
  [60, tune(n("~ [0 2 4] ~ [4 2 0]").scale(scaleAt(2)).slow(60).gain(0.028).attack(8.0).decay(6.0).sustain(0.75).release(16.0).cutoff(460).room(0.95).size(9).legato(1.2).orbit(8).midichan(8))],
  [60, tune(n("[2 0] ~ [0 3 2] ~").scale(scaleAt(2)).slow(60).gain(0.028).attack(8.0).decay(6.0).sustain(0.8).release(16.0).cutoff(470).room(0.95).size(9).legato(1.2).orbit(8).midichan(8))],
  [60, tune(n("~ [0 4 2] ~ [2 4 0]").scale(scaleAt(2)).slow(60).gain(0.030).attack(7.0).decay(6.0).sustain(0.8).release(16.0).cutoff(480).room(0.95).size(9).legato(1.2).orbit(8).midichan(8))],
  // IV. Grounding (50 + 50 + 50 = 150 c): Cantabile noble sosteniendo el clímax integrador
  [50, tune(n("[0 4] ~ [2 4] ~").scale(scaleAt(2)).slow(50).gain(0.030).attack(8.0).decay(6.0).sustain(0.8).release(16.0).cutoff(490).room(0.95).size(9).legato(1.2).orbit(8).midichan(8))],
  [50, tune(n("[0 2 0] ~ ~ [0]").scale(scaleAt(2)).slow(50).gain(0.026).attack(9.0).decay(6.0).sustain(0.85).release(18.0).cutoff(460).room(0.95).size(9).legato(1.2).orbit(8).midichan(8))],
  [50, tune(n("[0] ~ ~ ~").scale(scaleAt(2)).slow(50).gain(0.024).attack(10.0).decay(6.0).sustain(0.9).release(20.0).cutoff(430).room(0.95).size(9).legato(1.2).orbit(8).midichan(8))],
  // V. Transfiguration (40 + 40 + 40 = 120 c): Despedida asimétrica: reposa en Re y calla a 21:20 (c 640)
  [40, tune(n("0").scale(scaleAt(2)).slow(40).gain(0.020).attack(12.0).sustain(1.0).release(28.0).cutoff(390).room(0.95).size(9).legato(1.2).orbit(8).midichan(8))],
  [40, silence],
  [40, silence]
)
