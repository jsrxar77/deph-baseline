// "gnosis" — Generative ambient piece for deep meditation and trans-dimensional transport (24:00 exact)
// Concept: Cuerpo Material — ¿Prisión para el Alma o Varillas de Conexión a Tierra para Sophía?
// Reference: Agencia Cósmica
// Key: D:dorian calibrated to A4 = 432 Hz
// Duration: 24:00 exact (1440 seconds = 720 cycles at 30 cpm / 120 BPM in 4/4)
//
// Continuous 15-Stage Progressive Architecture (No repeating loops, continuous polyphonic counterpoint):
// Movement I.   Pleroma (0:00 - 4:00 | 120c = 60 + 30 + 30):
//   1. Unmanifest Silence (0:00 - 2:00 | 60c): Absolute void, fundamental D2 drone and sub.
//   2. Seed Awakening (2:00 - 3:00 | 30c): Single D3 bell awakens at 2:15.
//   3. Seed Breathing (3:00 - 4:00 | 30c): Sophia breathes D3-A3, Pad enters softly.
// Movement II.  Descent (4:00 - 9:00 | 150c = 50 + 50 + 50):
//   4. The Calling (4:00 - 5:40 | 50c): Sophia sings 3-note question (D3-F3-A3), Pad in Dsus2.
//   5. Earthly Awakening (5:40 - 7:20 | 50c): Warm Voice (Ch 8) awakens in cello register (D2-F2) with 10s attack. Tintinnabuli drops first dew.
//   6. Dialogue of Spheres (7:20 - 9:00 | 50c): Sophia melodic arch, Warm Voice responds in contrary motion.
// Movement III. Density / Crisol (9:00 - 15:00 | 180c = 60 + 60 + 60):
//   7. Modal Canon at the 5th (9:00 - 11:00 | 60c): Sophia subject imitated by Warm Voice at the fifth below. Pad in Gsus2/D.
//   8. Expressive Suspensions (11:00 - 13:00 | 60c): Dorian 6th B3 introduced, Pad in Bm7/D, cantabile counterpoint.
//   9. Polyphonic Tapestry (13:00 - 15:00 | 60c): 3-part vocal weave (Sophia, Warm Voice, Tintinnabuli) in peak density. Pad in Dm9.
// Movement IV.  Grounding / Clímax (15:00 - 20:00 | 150c = 50 + 50 + 50):
//   10. Grand Hymn (15:00 - 16:40 | 50c): Noble parallel and contrary motion, full Dorian integration.
//   11. The Grounding Anchor (16:40 - 18:20 | 50c): Descending resolution of Sophia, grounded bass resonance.
//   12. Transmutative Peace (18:20 - 20:00 | 50c): Spacious dyads, long breathing legato.
// Movement V.   Transfiguration (20:00 - 24:00 | 120c = 40 + 40 + 40):
//   13. Earthly Farewell (20:00 - 21:20 | 40c): Warm Voice sings final D2 pedal and falls silent at 21:20 (c 640).
//   14. Celestial Farewell (21:20 - 22:40 | 40c): Sophia strikes final solitary D3 bell at 22:00, Pad and Tintinnabuli fade.
//   15. The Eternal Silence (22:40 - 24:00 | 40c): Pure D2 drone and theta beat dissolve into zero at 24:00 exact.

setcpm(30) // 1 cycle = 2 seconds. 720 cycles = 1440s = 24:00 exact.

// ---- Tuning & Scale Foundation (D Dorian @ 432 Hz) ----------------------------------------------
const ROOT = 'D'
const KEY_SUFFIX = ':dorian'
const KEY = ROOT + KEY_SUFFIX; // "D:dorian"
const scaleAt = (octave) => ROOT + octave + KEY_SUFFIX

// A4 = 432 Hz calibration (deph standing standard: -31.77 cents offset)
const A4 = 432
const TUNE = 12 * Math.log2(A4 / 440); // -0.317666 semitones
const tune = (p) => p.add(note(TUNE))

// ---- Ch 1: Primordial Drone (Surge XT: Basses / Eighties Drone) ---------------------------------
// Cimiento continuo en D2 (73.4 Hz). Modula armónicos de quinta y octava a lo largo del viaje.
$: arrange(
  // I. Pleroma (60 + 30 + 30 = 120 c): Fundamental D2 pura inmutable
  [60, tune(n("0").scale(scaleAt(2)).slow(60).gain(0.070).attack(12.0).sustain(1.0).release(24.0).cutoff(220).room(0.95).size(9).legato(1.2).midichan(1))],
  [30, tune(n("0").scale(scaleAt(2)).slow(30).gain(0.070).attack(10.0).sustain(1.0).release(24.0).cutoff(220).room(0.95).size(9).legato(1.2).midichan(1))],
  [30, tune(n("[0, 4]").scale(scaleAt(2)).slow(30).gain(0.071).attack(10.0).sustain(1.0).release(24.0).cutoff(225).room(0.95).size(9).legato(1.2).midichan(1))],
  // II. Descent (50 + 50 + 50 = 150 c): Quinta abierta D2-A2 que acompaña el descenso
  [50, tune(n("[0, 4]").scale(scaleAt(2)).slow(50).gain(0.072).attack(10.0).sustain(1.0).release(24.0).cutoff(230).room(0.95).size(9).legato(1.2).midichan(1))],
  [50, tune(n("[0, 4]").scale(scaleAt(2)).slow(50).gain(0.072).attack(10.0).sustain(1.0).release(24.0).cutoff(230).room(0.95).size(9).legato(1.2).midichan(1))],
  [50, tune(n("[0, 4]").scale(scaleAt(2)).slow(50).gain(0.073).attack(10.0).sustain(1.0).release(24.0).cutoff(235).room(0.95).size(9).legato(1.2).midichan(1))],
  // III. Density (60 + 60 + 60 = 180 c): Apertura a octava completa D2-A2-D3 en el crisol
  [60, tune(n("[0, 4, 7]").scale(scaleAt(2)).slow(60).gain(0.074).attack(10.0).sustain(1.0).release(24.0).cutoff(240).room(0.95).size(9).legato(1.2).midichan(1))],
  [60, tune(n("[0, 4, 7]").scale(scaleAt(2)).slow(60).gain(0.075).attack(10.0).sustain(1.0).release(24.0).cutoff(240).room(0.95).size(9).legato(1.2).midichan(1))],
  [60, tune(n("[0, 4, 7]").scale(scaleAt(2)).slow(60).gain(0.075).attack(10.0).sustain(1.0).release(24.0).cutoff(245).room(0.95).size(9).legato(1.2).midichan(1))],
  // IV. Grounding (50 + 50 + 50 = 150 c): Plenitud armónica continua y retorno a quinta
  [50, tune(n("[0, 4, 7]").scale(scaleAt(2)).slow(50).gain(0.076).attack(10.0).sustain(1.0).release(24.0).cutoff(245).room(0.95).size(9).legato(1.2).midichan(1))],
  [50, tune(n("[0, 4]").scale(scaleAt(2)).slow(50).gain(0.074).attack(10.0).sustain(1.0).release(24.0).cutoff(240).room(0.95).size(9).legato(1.2).midichan(1))],
  [50, tune(n("[0, 4]").scale(scaleAt(2)).slow(50).gain(0.072).attack(10.0).sustain(1.0).release(24.0).cutoff(230).room(0.95).size(9).legato(1.2).midichan(1))],
  // V. Transfiguration (40 + 40 + 40 = 120 c): Disolución final a la raíz D2
  [40, tune(n("[0, 4]").scale(scaleAt(2)).slow(40).gain(0.068).attack(10.0).sustain(1.0).release(28.0).cutoff(220).room(0.95).size(9).legato(1.2).midichan(1))],
  [40, tune(n("0").scale(scaleAt(2)).slow(40).gain(0.065).attack(12.0).sustain(1.0).release(32.0).cutoff(200).room(0.95).size(9).legato(1.2).midichan(1))],
  [40, tune(n("0").scale(scaleAt(2)).slow(40).gain(0.060).attack(12.0).sustain(1.0).release(36.0).cutoff(180).room(0.95).size(9).legato(1.2).midichan(1))]
)

// ---- Ch 2: Varilla de Anclaje / Grounding Sub-Bass (Surge XT: Basses / Sub 1) -------------------
