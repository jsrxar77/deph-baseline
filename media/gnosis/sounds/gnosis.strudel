  [50, tune(n("0 3 4").scale(scaleAt(4)).slow(50).gain(0.024).cutoff(700).attack(8.0).sustain(1.0).release(16.0).room(0.95).size(9).pan(0.35).legato(1.2).orbit(6).midichan(6))],
  [50, tune(n("0 3 4").scale(scaleAt(4)).slow(50).gain(0.024).cutoff(700).attack(8.0).sustain(1.0).release(16.0).room(0.95).size(9).pan(0.65).legato(1.2).orbit(6).midichan(6))],
  [50, tune(n("0 2 4 6").scale(scaleAt(4)).slow(50).gain(0.025).cutoff(720).attack(8.0).sustain(1.0).release(16.0).room(0.95).size(9).pan(0.3).legato(1.2).orbit(6).midichan(6))],
  [60, tune(n("0 2 4 6").scale(scaleAt(4)).slow(60).gain(0.025).cutoff(750).attack(8.0).sustain(1.0).release(16.0).room(0.95).size(9).pan(0.7).legato(1.2).orbit(6).midichan(6))],
  [60, tune(n("0 4 6 7").scale(scaleAt(4)).slow(60).gain(0.026).cutoff(750).attack(8.0).sustain(1.0).release(16.0).room(0.95).size(9).pan(0.25).legato(1.2).orbit(6).midichan(6))],
  [60, tune(n("0 4 6 7").scale(scaleAt(4)).slow(60).gain(0.026).cutoff(750).attack(8.0).sustain(1.0).release(16.0).room(0.95).size(9).pan(0.75).legato(1.2).orbit(6).midichan(6))],
  [50, tune(n("0 4 6 4").scale(scaleAt(4)).slow(50).gain(0.026).cutoff(750).attack(8.0).sustain(1.0).release(16.0).room(0.95).size(9).pan(0.5).legato(1.2).orbit(6).midichan(6))],
  [50, tune(n("0 4 2").scale(scaleAt(4)).slow(50).gain(0.024).cutoff(700).attack(10.0).sustain(1.0).release(16.0).room(0.95).size(9).pan(0.4).legato(1.2).orbit(6).midichan(6))],
  [50, tune(n("0 4").scale(scaleAt(4)).slow(50).gain(0.022).cutoff(650).attack(10.0).sustain(1.0).release(18.0).room(0.95).size(9).pan(0.6).legato(1.2).orbit(6).midichan(6))],
  [40, tune(n("0 4").scale(scaleAt(4)).slow(40).gain(0.020).cutoff(600).attack(12.0).sustain(1.0).release(20.0).room(0.95).size(9).pan(0.5).legato(1.2).orbit(6).midichan(6))],
  [40, tune(n("0").scale(scaleAt(4)).slow(40).gain(0.016).cutoff(550).attack(14.0).sustain(1.0).release(24.0).room(0.95).size(9).pan(0.5).legato(1.2).orbit(6).midichan(6))],
