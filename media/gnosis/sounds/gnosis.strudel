)

// ---- Ch 6: Texturas Cósmicas / Viento Astral (Serum 2: Soundscape / SC - Astral Projection) ------
// Respiración espacial en el techo estéreo.
$: arrange(
  [60, tune(n("0").scale(scaleAt(4)).slow(60).gain(0.018).cutoff(550).attack(12.0).sustain(1.0).release(18.0).room(0.95).size(9).pan(0.5).legato(1.2).orbit(6).midichan(6))],
  [30, tune(n("0 4").scale(scaleAt(4)).slow(30).gain(0.020).cutoff(600).attack(10.0).sustain(1.0).release(18.0).room(0.95).size(9).pan(0.4).legato(1.2).orbit(6).midichan(6))],
